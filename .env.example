# Copy to .env and fill in real values. Never commit .env.
PORT=4000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kitchain
MONGODB_URI=

# Secret used to sign JWT auth tokens — use a long random string.
JWT_SECRET=

# How long auth tokens stay valid (e.g. 7d).
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Email notifications (FR-09) — optional. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown to recipients; use a verified domain in production
# (Resend's test sender is: KITCHAIN <onboarding@resend.dev>)
EMAIL_FROM=KITCHAIN <onboarding@resend.dev>
# Sandbox inbox — while EMAIL_FROM is @resend.dev (no verified domain), Resend only
# delivers to this address or manually authorized recipients, so certificate emails
# are routed here to avoid 422 errors. Set to your own email, or leave default.
EMAIL_TEST_INBOX=onboarding@resend.dev
# Public base URL of this API — used to build the PDF download link in emails
PUBLIC_API_URL=http://localhost:4000

# Blockchain (FR-06) — optional. When RPC + private key + contract address are
# all set, certificates are registered on the deployed CertificateRegistry
# contract (source: blockchain/contracts/CertificateRegistry.sol). Without them
# a deterministic simulation is used so local development still works.
# RPC endpoint for the network the contract is deployed on (Sepolia).
BLOCKCHAIN_RPC_URL=
# Wallet that deployed the contract (its owner) — must hold ETH to pay gas.
BLOCKCHAIN_PRIVATE_KEY=
# Address of the deployed CertificateRegistry contract (see blockchain/README.md).
BLOCKCHAIN_CONTRACT_ADDRESS=
# Display name for the network, shown on verification pages.
BLOCKCHAIN_NETWORK_NAME=Ethereum Sepolia
